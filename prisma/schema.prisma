generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String
  email               String    @unique
  passwordHash        String
  emailVerifiedAt     DateTime? @db.Timestamptz(3)
  passwordChangedAt   DateTime? @db.Timestamptz(3)
  codeWindowStartedAt DateTime? @db.Timestamptz(3)
  codeWindowAttempts  Int       @default(0)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  memberships   Membership[]
  assignedCards Card[]
  emailCodes    EmailCode[]

  @@map("users")
}

enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailCode {
  userId    String           @db.Uuid
  purpose   EmailCodePurpose
  codeHash  String
  sentAt    DateTime         @db.Timestamptz(3)
  expiresAt DateTime         @db.Timestamptz(3)
  attempts  Int              @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, purpose])
  @@map("email_codes")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  memberships Membership[]
  boards      Board[]

  @@map("workspaces")
}

model Membership {
  userId      String   @db.Uuid
  workspaceId String   @db.Uuid
  role        Role
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Board {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns   Column[]
  labels    Label[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("boards")
}

model Column {
  id        String   @id @default(uuid(7)) @db.Uuid
  boardId   String   @db.Uuid
  name      String
  position  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
  @@map("columns")
}

model Card {
  id          String   @id @default(uuid(7)) @db.Uuid
  columnId    String   @db.Uuid
  assigneeId  String?  @db.Uuid
  title       String
  description String?
  position    String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  column   Column      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  labels   CardLabel[]

  @@unique([columnId, position])
  @@index([assigneeId])
  @@map("cards")
}

enum LabelColor {
  GRAY
  RED
  ORANGE
  YELLOW
  GREEN
  TEAL
  BLUE
  PURPLE
}

model Label {
  id        String     @id @default(uuid(7)) @db.Uuid
  boardId   String     @db.Uuid
  name      String
  color     LabelColor
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardLabel[]

  @@map("labels")
}

model CardLabel {
  cardId  String @db.Uuid
  labelId String @db.Uuid

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}
