#!/bin/sh

if [ "$(git rev-parse --absolute-git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
  echo "hook: commits from a git worktree are not supported, the app container only sees the main checkout" >&2
  exit 1
fi

if ! docker compose exec -T app true >/dev/null 2>&1; then
  echo "hook: the app container is not running, start it with: docker compose up -d" >&2
  exit 1
fi

if ! docker compose exec -T app timeout 120 sh -c 'until [ -f /tmp/app-setup-finished ]; do sleep 1; done'; then
  echo "hook: the app container did not finish its setup, check: docker compose logs app" >&2
  exit 1
fi

exec docker compose exec -T app "$@"
